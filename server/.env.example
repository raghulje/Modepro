PORT=3020
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=modepro_cms
DB_USER=root
DB_PASSWORD=your_mysql_password
SKIP_DB_SYNC=false

# JWT (CMS admin)
JWT_SECRET=change-this-to-a-long-random-secret

# Kissflow Agentic AI
MODEPRO_AGENT_ID=your-modepro-kissflow-agent-id

# SMTP (contact form)
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-smtp-user@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=your-smtp-user@example.com
SMTP_FROM_NAME=Modepro India
CONTACT_FORM_EMAIL=info@modepro.com
